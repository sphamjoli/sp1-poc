#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
git diff --cached --check
while IFS= read -r -d '' file; do
  case "$file" in
    *.sh|.githooks/*) bash -n "$file" ;;
    *.json) git show ":$file" | python3 -c 'import json, sys; json.load(sys.stdin)' ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if git diff --cached --name-only --diff-filter=ACMR | rg -q '\.rs$'; then
  cargo fmt --all -- --check
fi
