FROM debian:bookworm-slim AS builder

ARG FOUNDRY_VERSION=v1.3.5
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bash \
    git \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash foundry
USER foundry
WORKDIR /home/foundry

ENV FOUNDRY_DIR=/home/foundry/.foundry
ENV PATH="${FOUNDRY_DIR}/bin:${PATH}"

RUN curl --proto '=https' --tlsv1.2 -fsSL \
      https://raw.githubusercontent.com/foundry-rs/foundry/v1.3.5/foundryup/foundryup -o /tmp/foundryup \
  && echo '7e66e775628501c218374103afb47cd4d5ca8b5a544701a9523d69470e9eed40  /tmp/foundryup' | sha256sum -c - \
  && mkdir -p "${FOUNDRY_DIR}/bin" \
  && bash /tmp/foundryup --install "${FOUNDRY_VERSION}" \
  && forge --version && cast --version && anvil --version


FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash foundry
USER foundry
WORKDIR /home/foundry

COPY --from=builder /home/foundry/.foundry/bin/ /home/foundry/.foundry/bin/
ENV PATH="/home/foundry/.foundry/bin:${PATH}"

EXPOSE 8545
ENTRYPOINT ["anvil"]
CMD ["--help"]
