FROM node:22-bookworm-slim

ARG FOUNDRY_VERSION=v1.3.5

ENV DEBIAN_FRONTEND=noninteractive
ENV FOUNDRY_DIR=/root/.foundry
ENV PATH="/root/.foundry/bin:${PATH}"

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
  && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -fsSL \
      https://raw.githubusercontent.com/foundry-rs/foundry/v1.3.5/foundryup/foundryup -o /tmp/foundryup \
  && echo '7e66e775628501c218374103afb47cd4d5ca8b5a544701a9523d69470e9eed40  /tmp/foundryup' | sha256sum -c - \
  && mkdir -p "${FOUNDRY_DIR}/bin" \
  && bash /tmp/foundryup --install "${FOUNDRY_VERSION}" \
  && forge --version && cast --version && anvil --version


COPY --from=oven/bun:1.4.2-debian /usr/local/bin/bun /usr/local/bin/bun
COPY package.json bun.lock /opt/upgrades/
RUN cd /opt/upgrades && bun install --frozen-lockfile
COPY tooling/npx-upgrades.sh /usr/local/bin/npx
RUN chmod +x /usr/local/bin/npx

WORKDIR /workspace/contracts
